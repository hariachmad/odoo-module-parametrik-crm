<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_custom" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="is_my_lead" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Mandatory" name="custom_info">
                    <group>
                        <group string="Prospect">
                            <field name="prospect_source" />
                            <field name="budget" />
                            <field name="est_timeline_start_date" />
                            <field name="est_timeline_end_date" />
                        </group>
                        <group string="Analysis">
                            <field name="pain_point" />
                            <field name="business_impact" />
                            <field name="competitors" />
                        </group>
                    </group>
                    <group>
                        <group string="Decision Making">
                            <field name="champion"/>
                            <field name="is_decision_maker" />
                            <field name="decision_process" />
                            <field name="decision_criteria" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="rule_mail_message_lead_tracking_user" model="ir.rule">
    <field name="name">Lead tracking: only salesperson</field>
    <field name="model_id" ref="mail.model_mail_message"/>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    <field name="domain_force">[
        '|', ('model', '!=', 'crm.lead'),
        '|', ('tracking_value_ids', '=', False),
             ('crm_lead_user_id', '=', user.id)
    ]</field>
</record>

<record id="rule_mail_message_lead_tracking_manager" model="ir.rule">
    <field name="name">Lead tracking: manager sees all</field>
    <field name="model_id" ref="mail.model_mail_message"/>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    <field name="domain_force">[(1, '=', 1)]</field>
</record>
</odoo>