<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_reject_wizard_form" model="ir.ui.view">
        <field name="name">crm.lead.reject.wizard.form</field>
        <field name="model">crm.lead.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Approval">
                <group>
                    <field name="lead_id" readonly="1"/>
                    <field name="reason" placeholder="Tuliskan alasan penolakan..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object"
                            string="Reject" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_lead_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Approval</field>
        <field name="res_model">crm.lead.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>